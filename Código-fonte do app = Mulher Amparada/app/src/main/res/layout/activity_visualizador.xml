<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- =========================================================
         VÍDEO
    ========================================================== -->

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#000000"
        android:keepScreenOn="true"
        android:elevation="0dp"
        app:use_controller="false"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- =========================================================
         IMAGEM
    ========================================================== -->

    <ImageView
        android:id="@+id/imgVisualizador"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:background="#000000" />

    <!-- =========================================================
         CARREGAMENTO
    ========================================================== -->

    <ProgressBar
        android:id="@+id/progresso"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtMensagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Carregando..."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- =========================================================
         CONTROLES PERSONALIZADOS
         FICA ACIMA DO PLAYER
    ========================================================== -->

    <LinearLayout
        android:id="@+id/playerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="20dp"
        android:background="@drawable/bg_player_controls">

        <!-- =====================================================
             BARRA
        ====================================================== -->

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:bar_height="6dp"
            app:touch_target_height="28dp"
            app:scrubber_enabled_size="14dp"
            app:scrubber_dragged_size="18dp"
            app:scrubber_disabled_size="8dp"
            app:played_color="#FFFFFFFF"
            app:buffered_color="#66FFFFFF"
            app:unplayed_color="#444444" />

        <!-- =====================================================
             TEMPO
        ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPosicao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtDuracao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- =====================================================
             BOTÕES
        ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- ANTERIOR -->

            <ImageButton
                android:id="@+id/btnAnterior"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_button"
                android:padding="13dp"
                android:src="@drawable/ic_player_previous"
                android:contentDescription="Anterior" />

            <!-- VOLTAR -->

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_player_button"
                android:padding="13dp"
                android:src="@drawable/ic_player_rewind"
                android:contentDescription="Voltar 10 segundos" />

            <!-- PLAY -->

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_player_button_main"
                android:padding="16dp"
                android:src="@drawable/exo_styled_controls_play"
                android:contentDescription="Reproduzir" />

            <!-- PAUSE -->

            <ImageButton
                android:id="@+id/btnPause"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_player_button_main"
                android:padding="16dp"
                android:src="@drawable/exo_styled_controls_pause"
                android:contentDescription="Pausar"
                android:visibility="gone" />

            <!-- AVANÇAR -->

            <ImageButton
                android:id="@+id/btnAvancar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_player_button"
                android:padding="13dp"
                android:src="@drawable/ic_player_forward"
                android:contentDescription="Avançar 10 segundos" />

            <!-- PRÓXIMO -->

            <ImageButton
                android:id="@+id/btnProximo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_button"
                android:padding="13dp"
                android:src="@drawable/ic_player_next"
                android:contentDescription="Próximo" />

        </LinearLayout>

        <!-- =====================================================
             REPETIR / ALEATÓRIO
        ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRepetir"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:padding="10dp"
                android:src="@drawable/ic_player_repeat"
                android:contentDescription="Repetição" />

            <ImageButton
                android:id="@+id/btnAleatorio"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:padding="10dp"
                android:src="@drawable/ic_player_shuffle"
                android:contentDescription="Aleatório" />

        </LinearLayout>

    </LinearLayout>

    <!-- =========================================================
         EDITOR
    ========================================================== -->

    <ScrollView
        android:id="@+id/scrollEditor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone"
        android:background="#000000"
        android:scrollbarThumbVertical="@drawable/scrollbar_personalizado">

        <TextView
            android:id="@+id/txtEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="16dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:background="#000000"
            android:textIsSelectable="true" />

    </ScrollView>

</FrameLayout>