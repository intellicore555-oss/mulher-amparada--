<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <!-- ================================================= -->
    <!-- ÁREA DOS CONTROLES -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/player_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_player_controller">

        <!-- Barra de progresso -->

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            app:bar_height="4dp"
            app:touch_target_height="28dp"
            app:scrubber_enabled_size="14dp"
            app:scrubber_dragged_size="18dp" />


        <!-- ================================================= -->
        <!-- TEMPO -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:text="0:00" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:text="0:00" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BOTÕES -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Voltar -->

            <ImageButton
                android:id="@+id/exo_rew"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_player_button"
                android:contentDescription="Voltar"
                android:padding="14dp"
                android:src="@drawable/exo_styled_controls_rewind"
                android:tint="#FFFFFF" />


            <!-- Play / Pause -->

            <ImageButton
                android:id="@+id/exo_play_pause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_player_button"
                android:contentDescription="Reproduzir ou pausar"
                android:padding="16dp"
                android:src="@drawable/exo_styled_controls_play"
                android:tint="#FFFFFF" />


            <!-- Avançar -->

            <ImageButton
                android:id="@+id/exo_ffwd"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_player_button"
                android:contentDescription="Avançar"
                android:padding="14dp"
                android:src="@drawable/exo_styled_controls_fast_forward"
                android:tint="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>