<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:id="@+id/player_controls_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:translationY="-24dp"
        android:background="@drawable/bg_player_controls">

        <!-- BARRA -->

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:bar_height="6dp"
            app:touch_target_height="28dp"
            app:scrubber_enabled_size="14dp"
            app:scrubber_dragged_size="18dp"
            app:scrubber_disabled_size="8dp"
            app:played_color="#FFFFFFFF"
            app:buffered_color="#66FFFFFF"
            app:unplayed_color="#444444" />

        <!-- TEMPO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exo_position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- CONTROLES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/exo_rew"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_player_button"
                android:contentDescription="Voltar 10 segundos"
                android:padding="14dp"
                android:src="@drawable/ic_player_rewind" />

            <ImageButton
                android:id="@+id/exo_play"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_player_button_main"
                android:contentDescription="Reproduzir"
                android:padding="17dp"
                android:src="@drawable/exo_styled_controls_play" />

            <ImageButton
                android:id="@+id/exo_pause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_player_button_main"
                android:contentDescription="Pausar"
                android:padding="17dp"
                android:src="@drawable/exo_styled_controls_pause" />

            <ImageButton
                android:id="@+id/exo_ffwd"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_player_button"
                android:contentDescription="Avançar 10 segundos"
                android:padding="14dp"
                android:src="@drawable/ic_player_forward" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>