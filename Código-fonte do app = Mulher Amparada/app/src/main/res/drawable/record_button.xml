<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#252A35" />
            <stroke
                android:width="2dp"
                android:color="#596171" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#303746"
                android:centerColor="#1D222C"
                android:endColor="#11141A" />

            <stroke
                android:width="1dp"
                android:color="#4A5160" />

            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp" />
        </shape>
    </item>

</selector>